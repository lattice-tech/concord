+    assert(!Concord::Asset::ModelLoader::Import(vertexCountPath.string()).HasGeometry());
+    std::filesystem::remove(vertexCountPath);
+
+    const std::filesystem::path truncatedPath = "asset_import_truncated_vertices.ply";
+    WriteTextFile(truncatedPath,
+                  "ply\n"
+                  "format ascii 1.0\n"
+                  "element vertex 4000000\n"
+                  "property float x\n"
+                  "property float y\n"
+                  "property float z\n"
+                  "end_header\n");
+    assert(!Concord::Asset::ModelLoader::Import(truncatedPath.string()).HasGeometry());
+    std::filesystem::remove(truncatedPath);
+
+    const std::filesystem::path faceListPath = "asset_import_face_list.ply";
+    WriteTextFile(faceListPath,
+                  "ply\n"
+                  "format ascii 1.0\n"
+                  "element vertex 3\n"
+                  "property float x\n"
+                  "property float y\n"
+                  "property float z\n"
+                  "element face 1\n"
+                  "property list uint uint vertex_indices\n"
+                  "end_header\n"
+                  "0 0 0\n"
+                  "1 0 0\n"
+                  "0 1 0\n"
+                  "65537\n");
+    assert(!Concord::Asset::ModelLoader::Import(faceListPath.string()).HasGeometry());
+    std::filesystem::remove(faceListPath);
+}
