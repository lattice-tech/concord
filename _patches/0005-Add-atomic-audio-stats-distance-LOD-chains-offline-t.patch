diff --git a/tests/assetCook/TextureMipChainTests.cpp b/tests/assetCook/TextureMipChainTests.cpp
new file mode 100644
index 0000000..4a309ad
--- /dev/null
+++ b/tests/assetCook/TextureMipChainTests.cpp
@@ -0,0 +1,100 @@
+#include "engine/asset/cook/TextureMipChain.h"
+#include "engine/asset/cook/CookedTexture.h"
+
+#include <cassert>
+#include <cstdint>
+#include <cstdlib>
+#include <vector>
+
+#ifdef assert
+#undef assert
+#endif
+#define assert(expression) do { if (!(expression)) std::abort(); } while (false)
+
+namespace {
+
+using Concord::Asset::BuildRgba8MipChain;
+using Concord::Asset::CookedTextureData;
+using Concord::Asset::RgbaImage;
+using Concord::Asset::TextureFormat;
+namespace CookedTexture = Concord::Asset::CookedTexture;
+
+RgbaImage Solid(std::uint32_t width, std::uint32_t height,
+                std::uint8_t r, std::uint8_t g, std::uint8_t b, std::uint8_t a)
+{
+    RgbaImage image;
+    image.width = width;
+    image.height = height;
+    image.pixels.resize(static_cast<std::size_t>(width) * height * 4u);
+    for (std::size_t i = 0; i < image.pixels.size(); i += 4) {
+        image.pixels[i + 0] = r;
+        image.pixels[i + 1] = g;
+        image.pixels[i + 2] = b;
+        image.pixels[i + 3] = a;
+    }
+    return image;
+}
+
+void TestChainReachesOneByOne()
+{
+    const CookedTextureData chain = BuildRgba8MipChain(Solid(8, 4, 10, 20, 30, 255), false);
+    // 8x4 -> 4x2 -> 2x1 -> 1x1: four levels.
+    assert(chain.mips.size() == 4);
+    assert(chain.format == TextureFormat::Rgba8);
+    assert(chain.mips.back().size() == 4);
+    // A constant image stays constant at every level.
+    assert(chain.mips.back()[0] == 10 && chain.mips.back()[1] == 20
+           && chain.mips.back()[2] == 30 && chain.mips.back()[3] == 255);
+}
+
+void TestNonPowerOfTwoAndInvalid()
+{
+    const CookedTextureData chain = BuildRgba8MipChain(Solid(5, 3, 1, 2, 3, 4), false);
+    // 5x3 -> 2x1 -> 1x1.
+    assert(chain.mips.size() == 3);
+    assert(chain.mips[1].size() == 2u * 1u * 4u);
+
+    RgbaImage bad;
+    bad.width = 4;
+    bad.height = 4; // pixels left empty -> invalid
+    assert(BuildRgba8MipChain(bad, false).mips.empty());
+}
+
+void TestSrgbAveragingIsLinear()
+{
+    // Half black, half white columns. Linear-correct averaging of sRGB 0 and
+    // 255 lands near sRGB 188 (linear 0.5); naive byte averaging gives 127/128.
+    RgbaImage image = Solid(2, 2, 0, 0, 0, 255);
+    for (std::uint32_t y = 0; y < 2; ++y) {
+        std::uint8_t* px = image.pixels.data() + (y * 2u + 1u) * 4u;
+        px[0] = px[1] = px[2] = 255;
+    }
+    const CookedTextureData srgb = BuildRgba8MipChain(image, true);
+    assert(srgb.format == TextureFormat::Rgba8Srgb);
+    assert(srgb.mips.size() == 2);
+    assert(srgb.mips[1][0] >= 180); // linear-space average, not 127
+    const CookedTextureData linear = BuildRgba8MipChain(image, false);
+    assert(linear.mips[1][0] <= 128);
+    // Alpha always averages linearly.
+    assert(srgb.mips[1][3] == 255);
+}
+
+void TestChainEncodesAsCookedTexture()
+{
+    const CookedTextureData chain = BuildRgba8MipChain(Solid(4, 4, 9, 9, 9, 9), true);
+    const std::vector<std::uint8_t> bytes = CookedTexture::Encode(chain);
+    const auto decoded = CookedTexture::Decode(bytes.data(), bytes.size());
+    assert(decoded.has_value());
+    assert(decoded->mips.size() == chain.mips.size());
+    assert(decoded->format == TextureFormat::Rgba8Srgb);
+}
+
+} // namespace
+
+void RunTextureMipChainTests()
+{
+    TestChainReachesOneByOne();
+    TestNonPowerOfTwoAndInvalid();
+    TestSrgbAveragingIsLinear();
+    TestChainEncodesAsCookedTexture();
+}
diff --git a/tests/audio/AudioCommandQueueTests.cpp b/tests/audio/AudioCommandQueueTests.cpp
new file mode 100644
index 0000000..ca81346
--- /dev/null
+++ b/tests/audio/AudioCommandQueueTests.cpp
@@ -0,0 +1,88 @@
+#include "audio/runtime/detail/AudioCommandQueue.h"
+
+#include <cassert>
+#include <cstdint>
+#include <cstdlib>
+#include <thread>
+
+#ifdef assert
+#undef assert
+#endif
+#define assert(expression) do { if (!(expression)) std::abort(); } while (false)
+
+namespace {
+
+using Concord::Audio::Detail::AudioCommand;
+using Concord::Audio::Detail::AudioCommandKind;
+using Concord::Audio::Detail::AudioCommandQueue;
+
+AudioCommand GainCommand(float value)
+{
+    AudioCommand command;
+    command.kind = AudioCommandKind::SetVoiceGain;
+    command.value = value;
+    return command;
+}
+
+void TestFullEmptyAndWraparound()
+{
+    AudioCommandQueue queue;
+    queue.Init(4);
+
+    AudioCommand out;
+    assert(!queue.TryPop(out));
+
+    for (int i = 0; i < 4; ++i) {
+        assert(queue.TryPush(GainCommand(static_cast<float>(i))));
+    }
+    assert(!queue.TryPush(GainCommand(99.0f)));
+    assert(queue.ApproxDepth() == 4);
+
+    for (int i = 0; i < 4; ++i) {
+        assert(queue.TryPop(out));
+        assert(out.value == static_cast<float>(i));
+    }
+    assert(!queue.TryPop(out));
+
+    // Wrap the ring several times to exercise the index masking.
+    for (int round = 0; round < 10; ++round) {
+        assert(queue.TryPush(GainCommand(static_cast<float>(round))));
+        assert(queue.TryPop(out));
+        assert(out.value == static_cast<float>(round));
+    }
+}
+
+void TestSpscStress()
+{
+    constexpr std::uint64_t kMessages = 200'000;
+    AudioCommandQueue queue;
+    queue.Init(256);
+
+    std::uint64_t received = 0;
+    std::uint64_t sum = 0;
+    std::thread consumer([&] {
+        AudioCommand out;
+        while (received < kMessages) {
+            if (queue.TryPop(out)) {
+                ++received;
+                sum += static_cast<std::uint64_t>(out.value);
+            }
+        }
+    });
+
+    for (std::uint64_t i = 0; i < kMessages; ++i) {
+        while (!queue.TryPush(GainCommand(1.0f))) {
+        }
+    }
+    consumer.join();
+    assert(received == kMessages);
+    assert(sum == kMessages);
+}
+
+} // namespace
+
+void RunAudioCommandQueueTests()
+{
+    TestFullEmptyAndWraparound();
+    TestSpscStress();
+}
diff --git a/tests/save/SaveArchiveTests.cpp b/tests/save/SaveArchiveTests.cpp
new file mode 100644
index 0000000..0a62697
--- /dev/null
+++ b/tests/save/SaveArchiveTests.cpp
@@ -0,0 +1,110 @@
+#include "engine/save/SaveArchive.h"
+
+#include <cassert>
+#include <cstdint>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+#ifdef assert
+#undef assert
+#endif
+#define assert(expression) do { if (!(expression)) std::abort(); } while (false)
+
+namespace {
+
+using Concord::Save::SaveArchive;
+namespace SaveSection = Concord::Save::SaveSection;
+
+void TestSectionRoundTrip()
+{
+    SaveArchive writer;
+    writer.BeginWrite();
+    assert(writer.BeginSection(SaveSection::kWorld));
+    writer.WriteU32(42u);
+    writer.WriteF32(1.5f);
+    writer.WriteString("海面场景");
+    writer.EndSection();
+    assert(writer.BeginSection(SaveSection::kPlayer));
+    writer.WriteF64(-3.25);
+    writer.WriteBool(true);
+    writer.EndSection();
+
+    std::vector<std::uint8_t> bytes;
+    assert(writer.Finish(bytes));
+    assert(writer.Ok());
+
+    SaveArchive reader;
+    assert(reader.OpenFromBuffer(bytes));
+    // Section order must not matter: read PLYR before WRLD.
+    assert(reader.EnterSection(SaveSection::kPlayer));
+    assert(reader.ReadF64() == -3.25);
+    assert(reader.ReadBool());
+    assert(reader.EnterSection(SaveSection::kWorld));
+    assert(reader.ReadU32() == 42u);
+    assert(reader.ReadF32() == 1.5f);
+    assert(reader.ReadString() == "海面场景");
+    assert(reader.Ok());
+}
+
+void TestUnknownSectionsAreSkipped()
+{
+    SaveArchive writer;
+    writer.BeginWrite();
+    assert(writer.BeginSection(0x54534554u)); // 'TEST': unknown to this reader
+    writer.WriteU64(7u);
+    writer.EndSection();
+    assert(writer.BeginSection(SaveSection::kAudio));
+    writer.WriteU8(9u);
+    writer.EndSection();
+
+    std::vector<std::uint8_t> bytes;
+    assert(writer.Finish(bytes));
+
+    SaveArchive reader;
+    assert(reader.OpenFromBuffer(bytes));
+    assert(!reader.HasSection(SaveSection::kWorld));
+    assert(reader.EnterSection(SaveSection::kAudio));
+    assert(reader.ReadU8() == 9u);
+    assert(reader.Ok());
+}
+
+void TestCorruptBufferIsRejected()
+{
+    SaveArchive writer;
+    writer.BeginWrite();
+    assert(writer.BeginSection(SaveSection::kMeta));
+    writer.WriteU32(1u);
+    writer.EndSection();
+    std::vector<std::uint8_t> bytes;
+    assert(writer.Finish(bytes));
+
+    // Bad magic.
+    std::vector<std::uint8_t> badMagic = bytes;
+    badMagic[0] ^= 0xFFu;
+    SaveArchive reader;
+    assert(!reader.OpenFromBuffer(badMagic));
+
+    // Truncated payload.
+    std::vector<std::uint8_t> truncated(bytes.begin(), bytes.begin()
+                                        + static_cast<std::ptrdiff_t>(bytes.size() / 2));
+    SaveArchive truncatedReader;
+    assert(!truncatedReader.OpenFromBuffer(truncated));
+
+    // Over-reading a section latches the error flag instead of running away.
+    SaveArchive overRead;
+    assert(overRead.OpenFromBuffer(bytes));
+    assert(overRead.EnterSection(SaveSection::kMeta));
+    (void)overRead.ReadU32();
+    (void)overRead.ReadU64();
+    assert(!overRead.Ok());
+}
+
+} // namespace
+
+void RunSaveArchiveTests()
+{
+    TestSectionRoundTrip();
+    TestUnknownSectionsAreSkipped();
+    TestCorruptBufferIsRejected();
+}
diff --git a/tools/cook/BimgTextureDecode.cpp b/tools/cook/BimgTextureDecode.cpp
new file mode 100644
index 0000000..002ed3a
--- /dev/null
+++ b/tools/cook/BimgTextureDecode.cpp
@@ -0,0 +1,43 @@
+#include "BimgTextureDecode.h"
+
+#include <bimg/decode.h>
+#include <bx/allocator.h>
+
+#include <cstring>
+
+namespace Concord::Asset {
+
+namespace {
+
+bx::AllocatorI& DecodeAllocator()
+{
+    static bx::DefaultAllocator allocator;
+    return allocator;
+}
+
+} // namespace
+
+TextureDecodeFn MakeBimgTextureDecode()
+{
+    return [](std::span<const std::uint8_t> bytes, RgbaImage& out,
+              std::string& errorOut) -> bool {
+        bimg::ImageContainer* container = bimg::imageParse(
+            &DecodeAllocator(), bytes.data(),
+            static_cast<std::uint32_t>(bytes.size()),
+            bimg::TextureFormat::RGBA8);
+        if (container == nullptr) {
+            errorOut = "bimg could not parse the image";
+            return false;
+        }
+        out.width = container->m_width;
+        out.height = container->m_height;
+        const std::size_t size = static_cast<std::size_t>(out.width)
+            * static_cast<std::size_t>(out.height) * 4u;
+        out.pixels.resize(size);
+        std::memcpy(out.pixels.data(), container->m_data, size);
+        bimg::imageFree(container);
+        return out.IsValid();
+    };
+}
+
+} // namespace Concord::Asset
diff --git a/tools/cook/BimgTextureDecode.h b/tools/cook/BimgTextureDecode.h
