+    const std::string allowed = Concord::Asset::Paths::ResolveWithin(
+        root.string(), "textures/albedo.png");
+    assert(!allowed.empty());
+    assert(Concord::Asset::Paths::ResolveWithin(root.string(), "../outside.bin").empty());
+    assert(Concord::Asset::Paths::ResolveWithin(
+        root.string(), std::filesystem::absolute("outside.bin").string()).empty());
+#if defined(_WIN32)
+    assert(Concord::Asset::Paths::ResolveWithin(root.string(), "..\\outside.bin").empty());
+    assert(Concord::Asset::Paths::ResolveWithin(root.string(), "C:\\outside.bin").empty());
+#endif
+
+    assert(std::filesystem::remove(root));
+}
+
+void TestPlyRejectsHostileCountsWithoutAllocatingDeclaredGeometry()
+{
+    const std::filesystem::path vertexCountPath = "asset_import_vertex_count.ply";
+    WriteTextFile(vertexCountPath,
