+    return result;
+}
+
+JsonValue String(std::string value)
+{
+    JsonValue result;
+    result.type = JsonValue::Type::String;
+    result.str = std::move(value);
+    return result;
+}
+
+JsonValue Object(std::initializer_list<std::pair<std::string, JsonValue>> members)
+{
+    JsonValue result;
+    result.type = JsonValue::Type::Object;
+    result.object.assign(members.begin(), members.end());
+    return result;
+}
+
+void WriteTextFile(const std::filesystem::path& path, const std::string& text)
+{
+    assert(!std::filesystem::exists(path));
+    std::ofstream file(path, std::ios::binary | std::ios::trunc);
+    assert(file);
+    file.write(text.data(), static_cast<std::streamsize>(text.size()));
+    assert(file);
+}
+
+void TestGltfCheckedOffsets()
+{
+    std::size_t result = 0;
+    assert(!Concord::Asset::Gltf::TryAddSize(
+        std::numeric_limits<std::size_t>::max(), 1, result));
+    assert(!Concord::Asset::Gltf::TryMultiplySize(
+        std::numeric_limits<std::size_t>::max(), 2, result));
+
+    const JsonValue invalidIntegers = Object({
+        {"fraction", Number(1.5)},
+        {"large", Number(static_cast<double>(std::numeric_limits<int>::max()) + 1.0)},
+    });
+    assert(invalidIntegers.IntOr("fraction", -1) == -1);
+    assert(invalidIntegers.IntOr("large", -1) == -1);
+
+    const JsonValue accessor = Object({
+        {"bufferView", Number(0)},
+        {"componentType", Number(5126)},
+        {"type", String("VEC4")},
+    });
+    const JsonValue bufferView = Object({
+        {"buffer", Number(0)},
+        {"byteOffset", Number(0)},
+        {"byteStride", Number(16)},
+    });
+    const std::vector<std::vector<std::uint8_t>> buffers(1, std::vector<std::uint8_t>(16));
+    const std::array<float, 16> values = Concord::Asset::Gltf::ReadAccessor(
+        accessor, buffers, {bufferView}, std::numeric_limits<std::size_t>::max());
+    for (float value : values) {
+        assert(value == 0.0f);
+    }
+
+    const JsonValue texture = Object({{"source", Number(0)}});
+    const JsonValue image = Object({{"bufferView", Number(0)}});
+    const JsonValue oversizedView = Object({
+        {"buffer", Number(0)},
+        {"byteOffset", Number(15)},
+        {"byteLength", Number(2)},
+    });
+    assert(Concord::Asset::Gltf::ResolveTexturePath(
+        texture, {image}, buffers, {oversizedView}, ".").empty());
+}
+
+void TestGltfExternalPathsStayInsideModelDirectory()
+{
+    const std::filesystem::path root = "concord_asset_import_security_test_root";
+    assert(!std::filesystem::exists(root));
+    assert(std::filesystem::create_directory(root));
